# Copy to deploy/.env ON THE VM and fill in. Never commit the filled version.
#
# Everything here is what Render's env group holds today, minus REDIS_URL —
# Redis now runs on this box and docker-compose sets that variable itself.

ENVIRONMENT=production

# --- Required: the app refuses to boot without real values ---
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# --- Neon (pooled connection string, asyncpg scheme) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?ssl=require

# --- Public origins ---
# www is canonical; the apex 308-redirects to it. NEXT_PUBLIC_API_URL on Vercel
# must be https://api.kliptos.app/api — the frontend appends /auth/google to it,
# so a missing /api suffix 404s and sign-in fails with a bare CallbackRouteError.
FRONTEND_URL=https://www.kliptos.app
API_PUBLIC_URL=https://api.kliptos.app
CORS_ORIGINS=https://www.kliptos.app,https://kliptos.app

# --- Google OAuth. GOOGLE_CLIENT_ID is the EXPECTED AUDIENCE of the ID token,
# so it must be byte-identical to Vercel's AUTH_GOOGLE_ID or every sign-in 401s.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini via Vertex. Cloud credits pay for Vertex, NOT the Developer API.
# GOOGLE_SA_JSON is the whole service-account JSON on one line.
GOOGLE_CLOUD_PROJECT=kliptos-505809
GOOGLE_SA_JSON=
# GOOGLE_VERTEX_LOCATION=global   # regional endpoints 404 on the -latest aliases

# Fallback only, for when Vertex is unconfigured. A creator's own key still
# goes to the Developer API on their quota.
GEMINI_API_KEY=

# --- Other providers ---
YOUTUBE_API_KEY=
PEXELS_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Cloudflare R2. All four must be set or media falls back to local disk,
# which on a cloud box means the site cannot see its own renders.
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Owner access: grants Studio plan and the economics panel ---
ADMIN_EMAILS=killerbesto17shubham@gmail.com,shubhamkushvanshi@gmail.com

# --- Off until billing exists; flip the day checkout ships ---
PLAN_ENFORCEMENT_ENABLED=false
RATE_LIMITS_ENABLED=true
