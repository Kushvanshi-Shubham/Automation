# ============================================================
# Kliptos — Environment Variables
# Copy this file to .env and fill in your values
# Generate secrets:
#   SECRET_KEY:            python -c "import secrets; print(secrets.token_urlsafe(48))"
#   TOKEN_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

ENVIRONMENT=development

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kliptos
REDIS_URL=redis://localhost:6379/0

# ----- Auth (backend) -----
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# ----- Auth (frontend / NextAuth) -----
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- LLM + images: Gemini via Vertex ("Agent Platform") -----
# Our own Gemini calls (scripts AND images) go through Vertex, because it
# bills the Cloud account so trial credits apply. The Gemini Developer API is
# a separate prepaid wallet that Cloud welcome credits cannot pay for at all
# on accounts created after 2026-03-02, and its free tier has NO image quota.
# GEMINI_API_KEY is now only a fallback for when Vertex isn't configured; a
# creator's BYO key still goes to the Developer API, on their quota.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SA_JSON_PATH=secrets/vertex-sa.json
# GOOGLE_SA_JSON=      # alternative: the whole JSON inline, for hosts that only take env vars
# GOOGLE_VERTEX_LOCATION=global   # regional endpoints 404 on the -latest aliases
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----- YouTube Data API (trending topics; plain API key) -----
YOUTUBE_API_KEY=

# ----- Visual Engines -----
PEXELS_API_KEY=
HIGGSFIELD_API_KEY=

# ----- TTS -----
ELEVENLABS_API_KEY=

# ----- Reddit -----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Kliptos/1.0

# ----- YouTube -----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ----- Instagram (Meta app; developers.facebook.com) -----
META_APP_ID=
META_APP_SECRET=
# Public base URL Meta fetches videos from (deployment URL; localhost won't work)
MEDIA_PUBLIC_URL=

# ----- Billing -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----- Storage -----
S3_BUCKET_NAME=kliptos-media
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000
