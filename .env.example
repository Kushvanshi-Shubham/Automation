# ============================================================
# Kliptos — Environment Variables
# Copy this file to .env and fill in your values
# Generate secrets:
#   SECRET_KEY:            python -c "import secrets; print(secrets.token_urlsafe(48))"
#   TOKEN_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

ENVIRONMENT=development

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kliptos
REDIS_URL=redis://localhost:6379/0

# ----- Auth (backend) -----
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# ----- Auth (frontend / NextAuth) -----
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- LLM (Gemini free tier preferred; OpenAI fallback) -----
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----- YouTube Data API (trending topics; plain API key) -----
YOUTUBE_API_KEY=

# ----- Visual Engines -----
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
PEXELS_API_KEY=
HIGGSFIELD_API_KEY=

# ----- TTS -----
ELEVENLABS_API_KEY=

# ----- Reddit -----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Kliptos/1.0

# ----- YouTube -----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ----- Billing -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----- Storage -----
S3_BUCKET_NAME=kliptos-media
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000
