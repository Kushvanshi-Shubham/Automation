# Cloud-mode overrides for running the render worker on this machine
# against the DEPLOYED stack (Neon + cloud Redis + R2).
#
#   copy to .env.cloud and fill the three values, then:
#     ./scripts/worker-cloud.ps1
#
# Everything not listed here is inherited from .env, so keys (Gemini,
# Pexels, Cartesia, R2 …) only live in one place.

# Neon POOLED connection string, asyncpg scheme, ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?ssl=require

# The queue the deployed API pushes jobs onto. Must be reachable from this
# machine, so an EXTERNAL url (Render Key Value free tier is internal-only;
# use Redis Cloud, or the paid Render plan's external url).
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# The deployed site, so OAuth redirects and CORS match production.
FRONTEND_URL=https://kliptos.vercel.app
API_PUBLIC_URL=https://kliptos-api.onrender.com
